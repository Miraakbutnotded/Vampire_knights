{
  "name": "survivors",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:art": "python3 scripts/validate-art.py",
    "cap:sync": "npm run build && npx cap sync ios"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "typescript": "~5.7.3",
    "vite": "^6.0.11",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/preferences": "^8.0.1"
  }
}
